#!/bin/bash
# Custom i3bar status generator with recording status, network, and datetime

# Print the header for i3bar JSON protocol
echo '{"version":1}'
echo '['
echo '[]'

while true; do
    # Read recording status
    STATUS=$(cat ~/.cache/sa-recording-status 2>/dev/null || echo "IDLE")

    # Build recording status block
    case "$STATUS" in
        RECORDING)
            REC_BLOCK='{"full_text":"[REC]","color":"#E5201D","name":"sa_status"}'
            ;;
        PROCESSING)
            REC_BLOCK='{"full_text":"[PROC]","color":"#F59335","name":"sa_status"}'
            ;;
        TRANSCRIBING)
            REC_BLOCK='{"full_text":"[TXT]","color":"#F59335","name":"sa_status"}'
            ;;
        AI_PROCESSING)
            REC_BLOCK='{"full_text":"[AI]","color":"#268BD2","name":"sa_status"}'
            ;;
        ERROR)
            REC_BLOCK='{"full_text":"[ERR]","color":"#CB4B16","name":"sa_status"}'
            ;;
        *)
            # IDLE - show idle status
            REC_BLOCK='{"full_text":"[IDLE]","color":"#586E75","name":"sa_status"}'
            ;;
    esac

    # Get music status via playerctl
    MUSIC_STATUS=$(playerctl status 2>/dev/null)
    if [ -z "$MUSIC_STATUS" ]; then
        MUSIC_BLOCK='{"full_text":"No Music","color":"#586E75","name":"music"}'
    else
        MUSIC_ARTIST=$(playerctl metadata xesam:artist 2>/dev/null)
        MUSIC_TITLE=$(playerctl metadata xesam:title 2>/dev/null)
        MUSIC_APP=$(playerctl metadata --format "{{playerName}}" 2>/dev/null)

        # Truncate title if combined display is too long (max 40 chars)
        MAX_LEN=40
        DISPLAY="${MUSIC_ARTIST} | ${MUSIC_TITLE} | ${MUSIC_APP}"
        if [ "${#DISPLAY}" -gt "$MAX_LEN" ]; then
            # Reserve chars for artist, separator, app, ellipsis
            OVERHEAD=$(( ${#MUSIC_ARTIST} + ${#MUSIC_APP} + 8 ))
            TITLE_MAX=$(( MAX_LEN - OVERHEAD ))
            if [ "$TITLE_MAX" -lt 4 ]; then
                TITLE_MAX=4
            fi
            if [ "${#MUSIC_TITLE}" -gt "$TITLE_MAX" ]; then
                MUSIC_TITLE="${MUSIC_TITLE:0:$TITLE_MAX}..."
            fi
            DISPLAY="${MUSIC_ARTIST} | ${MUSIC_TITLE} | ${MUSIC_APP}"
        fi

        # Escape for JSON (replace " with \")
        DISPLAY_ESCAPED="${DISPLAY//\"/\\\"}"

        if [ "$MUSIC_STATUS" = "Playing" ]; then
            MUSIC_BLOCK="{\"full_text\":\"${DISPLAY_ESCAPED}\",\"color\":\"#859900\",\"markup\":\"pango\",\"name\":\"music\"}"
        else
            # Paused: show with strikethrough
            MUSIC_BLOCK="{\"full_text\":\"<s>${DISPLAY_ESCAPED}</s>\",\"color\":\"#586E75\",\"markup\":\"pango\",\"name\":\"music\"}"
        fi
    fi

    # Get active player block
    ACTIVE_PLAYER=$(cat ~/.cache/sa-active-player 2>/dev/null)
    if [ -n "$ACTIVE_PLAYER" ]; then
        ACTIVE_PLAYER_ESCAPED="${ACTIVE_PLAYER//\"/\\\"}"
        ACTIVE_PLAYER_BLOCK="{\"full_text\":\"[${ACTIVE_PLAYER_ESCAPED}]\",\"color\":\"#268BD2\",\"name\":\"active_player\"}"
    else
        ACTIVE_PLAYER_BLOCK="{\"full_text\":\"[auto]\",\"color\":\"#586E75\",\"name\":\"active_player\"}"
    fi

    # Get network status
    # Check for active network interface (excluding loopback)
    ACTIVE_IF=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+')

    if [ -n "$ACTIVE_IF" ]; then
        # Check if it's WiFi or Ethernet
        if [ -d "/sys/class/net/$ACTIVE_IF/wireless" ]; then
            # WiFi - get SSID
            SSID=$(iwgetid -r 2>/dev/null)
            if [ -n "$SSID" ]; then
                NET_BLOCK="{\"full_text\":\"WiFi: $SSID\",\"color\":\"#859900\",\"name\":\"network\"}"
            else
                NET_BLOCK='{"full_text":"WiFi","color":"#859900","name":"network"}'
            fi
        else
            # Wired connection
            NET_BLOCK='{"full_text":"NET: Ethernet","color":"#859900","name":"network"}'
        fi
    else
        # No connection
        NET_BLOCK='{"full_text":"NET: Disconnected","color":"#DC322F","name":"network"}'
    fi

    # Get current date and time
    DATETIME=$(date '+%Y-%m-%d %H:%M:%S')
    DATETIME_BLOCK="{\"full_text\":\"$DATETIME\",\"color\":\"#93A1A1\",\"name\":\"datetime\"}"

    # Build the status array
    BLOCKS=()

    # Always add recording status (including IDLE)
    BLOCKS+=("$REC_BLOCK")

    # Music and active player
    BLOCKS+=("$MUSIC_BLOCK")
    BLOCKS+=("$ACTIVE_PLAYER_BLOCK")

    # Always add network and datetime
    BLOCKS+=("$NET_BLOCK")
    BLOCKS+=("$DATETIME_BLOCK")

    # Join blocks with commas
    OUTPUT="["
    for i in "${!BLOCKS[@]}"; do
        OUTPUT+="${BLOCKS[$i]}"
        [ $i -lt $((${#BLOCKS[@]} - 1)) ] && OUTPUT+=","
    done
    OUTPUT+="]"

    echo ",$OUTPUT"

    # Update every second
    sleep 1
done
