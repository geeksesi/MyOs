#!/bin/bash
# Voice recording stop, transcribe, and AI processing script
# Stops recording, gets transcript, processes with Claude, and logs results

TIMESTAMP=$(date +%Y-%m-%d-%H-%M-%S)
LOGFILE=~/Downloads/bin/log/${TIMESTAMP}.log

# Update status to processing
echo "PROCESSING" > ~/.cache/sa-recording-status
notify-send "⏸️  Processing" "Stopping recording..."

# Stop recording
OUTPUT=$(~/Downloads/bin/sa stop 2>&1)
if [ $? -ne 0 ]; then
    echo "ERROR" > ~/.cache/sa-recording-status
    notify-send -u critical "❌ Stop Error" "$OUTPUT"
    exit 1
fi

# Get transcript
echo "TRANSCRIBING" > ~/.cache/sa-recording-status
notify-send "📝 Transcribing" "Converting speech to text..."

TRANSCRIPT=$(~/Downloads/bin/sa transcript 2>&1)
if [ $? -ne 0 ]; then
    echo "ERROR" > ~/.cache/sa-recording-status
    notify-send -u critical "❌ Transcribe Error" "$TRANSCRIPT"
    exit 1
fi

# Check if transcript is empty
if [ -z "$TRANSCRIPT" ]; then
    echo "ERROR" > ~/.cache/sa-recording-status
    notify-send -u critical "❌ Empty Transcript" "No speech detected"
    exit 1
fi

# Process with Claude
echo "AI_PROCESSING" > ~/.cache/sa-recording-status
notify-send "🤖 AI Processing" "Sending to Claude..."

CLAUDE_OUTPUT=$(echo "$TRANSCRIPT" | /home/geeksesi/.local/bin/claude -p --model 'haiku' 2>&1)
if [ $? -ne 0 ]; then
    echo "ERROR" > ~/.cache/sa-recording-status
    notify-send -u critical "❌ Claude Error" "$CLAUDE_OUTPUT"
    exit 1
fi

# Copy to clipboard
echo "$CLAUDE_OUTPUT" | xclip -selection clipboard
notify-send "📋 Success" "Copied to clipboard"

# Log everything
{
    echo "$(date '+%Y-%m-%d %H:%M:%S')"
    echo "=== TRANSCRIPT ==="
    echo "$TRANSCRIPT"
    echo ""
    echo "---"
    echo ""
    echo "=== CLAUDE RESPONSE ==="
    echo "$CLAUDE_OUTPUT"
} > "$LOGFILE"

# Reset status to idle
echo "IDLE" > ~/.cache/sa-recording-status

exit 0
