#!/bin/bash
# Voice recording stop, transcribe, and AI processing script
# Stops recording, gets transcript, processes with opencode, and logs results

TIMESTAMP=$(date +%Y-%m-%d-%H-%M-%S)
LOGFILE=~/Downloads/bin/log/${TIMESTAMP}.log

# Update status to processing
echo "PROCESSING" > ~/.cache/sa-recording-status
notify-send "⏸️  Processing" "Stopping recording..."

# Stop recording
OUTPUT=$(~/Downloads/bin/sa stop 2>&1)
if [ $? -ne 0 ]; then
    echo "ERROR" > ~/.cache/sa-recording-status
    notify-send -u critical "❌ Stop Error" "$OUTPUT"
    exit 1
fi

# Get transcript
echo "TRANSCRIBING" > ~/.cache/sa-recording-status
notify-send "📝 Transcribing" "Converting speech to text..."

TRANSCRIPT=$(~/Downloads/bin/sa transcript 2>&1)
if [ $? -ne 0 ]; then
    echo "ERROR" > ~/.cache/sa-recording-status
    notify-send -u critical "❌ Transcribe Error" "$TRANSCRIPT"
    exit 1
fi

# Check if transcript is empty
if [ -z "$TRANSCRIPT" ]; then
    echo "ERROR" > ~/.cache/sa-recording-status
    notify-send -u critical "❌ Empty Transcript" "No speech detected"
    exit 1
fi

# Process with opencode
echo "AI_PROCESSING" > ~/.cache/sa-recording-status
notify-send "🤖 AI Processing" "Sending to opencode..."

# Create custom prompt for opencode to clean up STT output
PROMPT="You are receiving a speech-to-text transcript that may contain errors. Your task is to fix it while preserving ALL the original content and meaning.

Instructions:
1. Fix spelling mistakes and misheard words
2. Correct grammar and punctuation
3. Fix words that don't fit the context (likely STT errors)
4. Keep ALL filler words, repetitions, and hesitations - they are part of the original speech
5. Do NOT summarize, shorten, or remove any parts
6. Do NOT rephrase - keep the original speaking style
7. Preserve the complete length and all details from the original

Output ONLY the corrected text, nothing else. Do not add explanations or comments.

Transcript:
$TRANSCRIPT"

set -o pipefail
OPENCODE_OUTPUT=$(printf '%s' "$PROMPT" | /home/geeksesi/.opencode/bin/opencode run --model opencode-go/deepseek-v4-flash --format json 2>&1 | node -e 'const readline = require("readline"); const rl = readline.createInterface({ input: process.stdin }); rl.on("line", line => { try { const event = JSON.parse(line); if (event.type === "text" && event.part && typeof event.part.text === "string") process.stdout.write(event.part.text); } catch (_) { process.stderr.write(line + "\n"); } });' 2>&1)
if [ $? -ne 0 ]; then
    echo "ERROR" > ~/.cache/sa-recording-status
    notify-send -u critical "❌ opencode Error" "$OPENCODE_OUTPUT"
    exit 1
fi

if [ -z "$OPENCODE_OUTPUT" ]; then
    echo "ERROR" > ~/.cache/sa-recording-status
    notify-send -u critical "❌ opencode Error" "No corrected text returned"
    exit 1
fi

# Copy to clipboard
echo "$OPENCODE_OUTPUT" | xclip -selection clipboard
notify-send "📋 Success" "Copied to clipboard"

# Log everything
{
    echo "$(date '+%Y-%m-%d %H:%M:%S')"
    echo "=== TRANSCRIPT ==="
    echo "$TRANSCRIPT"
    echo ""
    echo "---"
    echo ""
    echo "=== OPENCODE RESPONSE ==="
    echo "$OPENCODE_OUTPUT"
} > "$LOGFILE"

# Reset status to idle
echo "IDLE" > ~/.cache/sa-recording-status

exit 0
