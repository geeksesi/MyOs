set shell=/bin/fish

" Vimeatic
set number	
set showbreak=+++ 	
set textwidth=100
set showmatch	

set hlsearch	
set smartcase	
set ignorecase	
set incsearch	

set autoindent	
set cindent	
set expandtab	
set shiftwidth=4
set smartindent	
set smarttab	
set softtabstop=4	
set textwidth=0 wrapmargin=0
set wrap

set undolevels=1000
set backspace=indent,eol,start	

" No swap
set noswapfile
