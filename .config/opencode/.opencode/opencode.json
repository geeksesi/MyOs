{
  "$schema": "https://opencode.ai/config.json",
  "logLevel": "INFO",
  "share": "auto",
  "autoupdate": true,
  "snapshot": true,
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "tail_turns": 20,
    "threshold_tokens": 200000,
    "target_tokens": 200000,
    "model_context_fallback": 300000
  }
}
